# Survival OS — configuración de ejemplo. Copiar a `.env` (NO se versiona).
# No contiene ni debe contener secretos.

# --- Servidor web (Nuxt/Nitro) ---
# Solo loopback por defecto. Exponer en LAN/AP requiere diseño explícito (ver docs/security-model.md).
NITRO_HOST=127.0.0.1
NITRO_PORT=3000

# URL interna del servicio de dispositivo (consumida solo por el servidor web, nunca por el navegador).
NUXT_DEVICE_API_URL=http://127.0.0.1:8781

# --- device-api ---
DEVICE_API_HOST=127.0.0.1
DEVICE_API_PORT=8781
# Segundos que se reutiliza una lectura de estado antes de volver a medir.
DEVICE_API_CACHE_SECONDS=5
# Puntos de montaje cuyo espacio libre se informa (separados por comas).
DEVICE_API_MOUNTS=/,/boot/firmware

# --- Registro ---
# info | warn | error. Nunca se registran contraseñas ni contenido privado.
LOG_LEVEL=info
