[Unit]
Description=Survival OS - pasarela ESP32 (USB serie, JSON Lines v1)
After=gpsd.socket
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=survival
Group=survival
EnvironmentFile=-/etc/survival-os/survival-os.env
ExecStart=/opt/survival-os/runtime/node/bin/node /opt/survival-os/current/services/esp32-gateway/dist/server.js
Restart=on-failure
RestartSec=5
Nice=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Acceso a puertos serie (grupo dialout); sin otros dispositivos.
DevicePolicy=closed
DeviceAllow=char-ttyACM rw
DeviceAllow=char-ttyUSB rw
SupplementaryGroups=dialout
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
Environment=UV_THREADPOOL_SIZE=8
MemoryMax=128M

[Install]
WantedBy=multi-user.target
