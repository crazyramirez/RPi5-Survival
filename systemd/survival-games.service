# Juegos offline (ADR 0012): copia local de Viseni Games en 127.0.0.1:8790, otro origen que la web.
# Solo lectura de /var/lib/survival-os/games/current (la escribe la tarea `games`, survival-admin@games).
[Unit]
Description=Survivelia OS - juegos offline (Viseni Games, loopback, solo lectura)
After=local-fs.target

[Service]
Type=simple
User=survival
Group=survival
Environment=GAMES_HOST=127.0.0.1
Environment=GAMES_PORT=8790
Environment=GAMES_DIR=/var/lib/survival-os/games/current
ExecStart=/opt/survival-os/runtime/node/bin/node /opt/survival-os/current/scripts/games-server.mjs
Restart=on-failure
RestartSec=3
Nice=5

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=128M

[Install]
WantedBy=multi-user.target
