[Unit]
Description=Survivelia OS - receptor GNSS USB en %I (sondeo NMEA para gpsd)
# Lo lanza udev al conectar un puerto ttyACM*/ttyUSB* (70-survival-os.rules). Solo escucha el puerto.
After=gpsd.socket
ConditionPathExists=/dev/%I

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/survival-os/current/scripts/gps-usb-probe.py /dev/%I
TimeoutStartSec=90
Nice=10

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-ttyACM r
DeviceAllow=char-ttyUSB r
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=64M
