[Unit]
Description=Survival OS - kiwix-serve (ZIM offline, loopback)
After=local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=survival
Group=survival
ExecStartPre=/opt/survival-os/current/scripts/kiwix-library-init.sh
ExecStart=/opt/survival-os/runtime/kiwix-tools/kiwix-serve --address=127.0.0.1 --port=8783 --urlRootLocation=/kiwix --threads=2 --monitorLibrary --library /var/lib/survival-os/library/zim/library.xml
Restart=on-failure
RestartSec=5
Nice=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
# AF_NETLINK: kiwix-serve usa getifaddrs() para validar la dirección de escucha.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/survival-os/library/zim
MemoryMax=512M

[Install]
WantedBy=multi-user.target
