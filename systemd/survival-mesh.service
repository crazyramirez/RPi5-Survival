[Unit]
Description=Survival OS - malla Meshtastic (nodo LoRa por USB, loopback)
# Solo arranca si la tarea «mesh» de Mantenimiento instaló el entorno Python.
ConditionPathExists=/opt/survival-os/runtime/mesh-venv/bin/python
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=survival
Group=survival
SupplementaryGroups=dialout
EnvironmentFile=-/etc/survival-os/mesh.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/survival-os/runtime/mesh-venv/bin/python -I /opt/survival-os/current/services/mesh/survival_mesh.py
Restart=on-failure
RestartSec=5
Nice=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Necesita /dev/ttyACM* del nodo: sin PrivateDevices, pero solo dispositivos serie.
DevicePolicy=closed
DeviceAllow=char-ttyACM rw
DeviceAllow=char-ttyUSB rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
IPAddressDeny=any
IPAddressAllow=localhost
StateDirectory=survival-os/mesh
ReadWritePaths=/var/lib/survival-os/mesh
MemoryMax=256M

[Install]
WantedBy=multi-user.target
