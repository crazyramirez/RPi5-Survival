[Unit]
Description=Survival OS - navegación (cliente gpsd, waypoints, tracks GPX)
After=gpsd.socket
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=survival
Group=survival
EnvironmentFile=-/etc/survival-os/survival-os.env
ExecStart=/opt/survival-os/runtime/node/bin/node /opt/survival-os/current/services/navigation/dist/server.js
Restart=on-failure
RestartSec=5
Nice=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/survival-os/navigation
MemoryMax=128M

[Install]
WantedBy=multi-user.target
