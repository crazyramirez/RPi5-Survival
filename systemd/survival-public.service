# Vista pública de solo lectura para el punto de acceso Wi-Fi local (ADR 0009).
# NO se habilita al arranque: la arranca/para la tarea `ap` (survival-admin@ap) junto con el AP.
# Escucha solo en la IP del AP (10.42.0.1:80) y reenvía una lista blanca de GET a la web local.
[Unit]
Description=Survival OS - vista pública del punto de acceso (solo lectura)
After=survival-web.service NetworkManager.service
Requires=survival-web.service

[Service]
Type=simple
User=survival
Group=survival
EnvironmentFile=-/etc/survival-os/survival-os.env
Environment=PUBLIC_HOST=10.42.0.1
Environment=PUBLIC_PORT=80
ExecStart=/opt/survival-os/runtime/node/bin/node /opt/survival-os/current/scripts/public-gateway.mjs
Restart=on-failure
RestartSec=3

# Solo el permiso de abrir el puerto 80; nada más.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET
IPAddressDeny=any
IPAddressAllow=localhost 10.42.0.0/24
MemoryMax=96M
