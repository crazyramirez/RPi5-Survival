# Rutas sin conexión (ADR 0010): servidor BRouter solo en loopback (127.0.0.1:17777).
# Solo arranca si la tarea «routing» de Mantenimiento instaló BRouter y al menos una cuadrícula.
[Unit]
Description=Survival OS - rutas sin conexión (BRouter, loopback)
After=local-fs.target
ConditionPathExists=/opt/survival-os/runtime/brouter/brouter.jar
ConditionDirectoryNotEmpty=/var/lib/survival-os/routing/segments4
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=survival
Group=survival
# 256 MiB de montón: suficiente para rutas de cientos de km con BRouter; un solo hilo (la Pi también sirve
# el mapa y el asistente). maxRunningTime limita cada cálculo a 60 s.
ExecStart=/usr/bin/java -Xmx256M -Xms64M -Xmn8M -DmaxRunningTime=60 -DuseRFCMimeType=false -DusePOSTRequests=false -cp /opt/survival-os/runtime/brouter/brouter.jar btools.server.RouteServer /var/lib/survival-os/routing/segments4 /opt/survival-os/runtime/brouter/profiles2 /var/lib/survival-os/routing/customprofiles 17777 1 127.0.0.1
Restart=on-failure
RestartSec=5
Nice=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/var/lib/survival-os/routing
MemoryMax=400M

[Install]
WantedBy=multi-user.target
