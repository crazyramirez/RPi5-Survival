[Unit]
Description=Survival OS - interfaz web (Nuxt/Nitro, loopback)
Documentation=file:///opt/survival-os/current/README.md
After=survival-device-api.service
Wants=survival-device-api.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=survival
Group=survival
EnvironmentFile=-/etc/survival-os/survival-os.env
Environment=NODE_ENV=production
ExecStart=/opt/survival-os/runtime/node/bin/node /opt/survival-os/current/apps/frontend/.output/server/index.mjs
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
# FIFO del kiosco, sockets de servicios y datos de usuario (mapas, tracks, biblioteca).
ReadWritePaths=/run/survival-os /var/lib/survival-os
MemoryMax=384M

[Install]
WantedBy=multi-user.target
