# Survival OS — puertos serie USB.
# ESP32-S3 con USB nativo (Espressif 303a:*): grupo dialout, nombre estable y fuera de ModemManager y gpsd.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", GROUP="dialout", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1", SYMLINK+="survival-esp32-%n"
# Puentes USB-serie usados por placas ESP32 y también por receptores GPS: solo se excluyen de ModemManager.
# (Para dedicar uno concreto al ESP32, ver services/esp32-gateway/README.md.)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ENV{ID_MM_DEVICE_IGNORE}="1"
