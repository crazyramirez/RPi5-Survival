# Survival OS — arranca el kiosco en cuanto la sesión Wayland está lista,
# sin esperar al autostart del escritorio (que en este equipo tarda ~35 s más).
# Instalado en /etc/systemd/user/ y habilitado con --global.
[Unit]
Description=Survival OS - espera a la sesión Wayland
ConditionUser=@KIOSK_USER@

[Path]
PathExists=%t/wayland-0
Unit=survival-kiosk.service

[Install]
WantedBy=default.target
